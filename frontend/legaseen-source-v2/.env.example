# Copy to .env.local and fill in. The anon key is safe in a browser: every
# read and write is gated by row-level security, and the pipeline never uses
# a service-role key.

VITE_SUPABASE_URL=https://vofogqdxxmjoqdfcsgen.supabase.co
VITE_SUPABASE_ANON_KEY=

# The two edge functions. Locally these are Deno processes (see the README);
# in production they are https://<project>.supabase.co/functions/v1/<name>.
VITE_SEARCH_URL=http://localhost:8000/
VITE_INTERVIEW_URL=http://localhost:8001/
